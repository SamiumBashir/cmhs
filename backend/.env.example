# =================================================================
# Chilahati Merchants High School Management System (CMHS)
# Production & Development Environment Configuration Template
# =================================================================

# Server & Network Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database & Cache (Required)
# In production, provide your MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/school-management
# Optional: Redis connection URL for caching
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Required in Production: min 32 characters)
JWT_SECRET=your_super_secret_access_token_signing_key_min_32_chars
JWT_EXPIRY=30m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_signing_key_min_32_chars
REFRESH_TOKEN_EXPIRY=14d

# Initial CLI Seeding Configuration (Used by npm run seed / npm run seed:admin)
INITIAL_ADMIN_EMAIL=admin@cmhs.edu.bd
INITIAL_ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Cloudinary Storage Configuration (Optional, for image & asset storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email & Notifications (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
